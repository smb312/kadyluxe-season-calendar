# Copy to .env.local and fill in from Supabase → Project Settings → API.
# .env.local is gitignored. Never commit real values.

# ---- Public (safe to expose to the browser) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---- Server-only (NEVER exposed to the client) ----
# Used only by the admin API routes and the seed/test scripts.
# This is the "service_role" secret from the same API settings page.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Seed / test scripts only ----
# Direct Postgres connection string (Supabase → Project Settings → Database →
# Connection string → URI). Used by the seed and RLS test scripts.
# Not needed by the Next.js app at runtime.
SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# ---- RLS viewer-rejection test credentials ----
# The two accounts you create in Phase 2 of SETUP.md. The test signs in as
# each and asserts what the database allows. Fill these in before running it.
TEST_ADMIN_EMAIL=admin@example.com
TEST_ADMIN_PASSWORD=
TEST_VIEWER_EMAIL=viewer@example.com
TEST_VIEWER_PASSWORD=
